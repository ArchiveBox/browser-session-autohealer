# Copy to .env and fill in your own values. .env is ignored by Git.
# Browser Session Autohealer loads this file without overriding an existing process environment.

OPENAI_API_KEY=
# Optional: configure the project ID and browser options in Browser Providers.
BROWSERBASE_API_KEY=

ACCOUNT_CHECKER_CONFIG=~/.config/account-checker
ACCOUNT_CHECKER_DATA=~/.local/share/account-checker
ACCOUNT_CHECKER_TIME_ZONE=UTC
# Optional: otherwise bootstrap creates a private local database configuration.
# ACCOUNT_CHECKER_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/session_tender

# Optional live acceptance-test inputs; use your own retained runs and accounts.
# Tests requiring these values fail if the configuration or real evidence is missing.
ACCOUNT_CHECKER_EXPECTED_IDENTITY=
ACCOUNT_CHECKER_TEST_VAULT=
ACCOUNT_CHECKER_TEST_ITEM=
ACCOUNT_CHECKER_ONEPASSWORD_RUN=
ACCOUNT_CHECKER_COMPARE_BASE=
ACCOUNT_CHECKER_COMPARE_HEAD=
ACCOUNT_CHECKER_PRIVATE_DIAGNOSTIC=
ACCOUNT_CHECKER_IMPORT_CHECKPOINT=
ACCOUNT_CHECKER_SUCCESS_RUNS=
ACCOUNT_CHECKER_BLOCKED_RUN=

# Optional remote browser providers. Keys never belong in provider JSON.
BROWSERLESS_API_KEY=
KERNEL_API_KEY=
ANCHOR_BROWSER_API_KEY=
ZENROWS_API_KEY=
# Generic CDP provider config: {"endpoint_env": "CDP_BROWSER_URL"}
CDP_BROWSER_URL=
# GeoLite2 City downloads automatically into ACCOUNT_CHECKER_DATA/geoip.
# Optional: use your own database instead (never overwritten or auto-updated).
# MAXMIND_CITY_DB=/path/to/GeoIP2-City.mmdb
SESSION_IP_PROBE_URL=https://api64.ipify.org?format=json
